{
  "manifest_version": 3,
  "name": "AI History Recall Capture",
  "version": "0.1.42",
  "description": "Capture the current logged-in AI conversation into local AI History Recall.",
  "permissions": ["activeTab", "storage", "tabs", "windows", "alarms", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:32145/*",
    "http://127.0.0.1:3000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://chat2-api.qianwen.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background-entry.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "core/constants.js",
        "core/protocol.js",
        "platforms/registry.js",
        "core/dom.js",
        "platforms/chatgpt.js",
        "platforms/gemini.js",
        "platforms/deepseek.js",
        "platforms/qwen.js",
        "incremental-sync.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
