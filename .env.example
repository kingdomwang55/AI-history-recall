AIHR_DB_PATH=
AIHR_API_TOKEN=
NEXT_PUBLIC_AIHR_EXTENSION_PATH=
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PATH=
CHROME_USER_DATA_DIR=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional generative enhancement for summaries and automatic tags.
# Leave disabled by default. Gemma 4 can be used through an OpenAI-compatible
# chat/completions endpoint, but it is not an embedding model.
AIHR_KNOWLEDGE_MODEL_ENABLED=false
AIHR_KNOWLEDGE_MODEL_TIMEOUT_MS=

# Semantic search embeddings.
# Leave these empty by default. The app will use the built-in offline semantic index
# and will not start or call any external/local embedding model.
#
# Optional local Ollama setup:
#   ollama pull embeddinggemma
#   AIHR_EMBEDDING_PROVIDER=ollama
#   AIHR_EMBEDDING_MODEL=embeddinggemma
#   AIHR_EMBEDDING_BASE_URL=http://127.0.0.1:11434
AIHR_EMBEDDING_PROVIDER=
AIHR_EMBEDDING_MODEL=
AIHR_EMBEDDING_BASE_URL=
AIHR_EMBEDDING_API_KEY=
AIHR_EMBEDDING_TIMEOUT_MS=

# Desktop packaging only. Must point to the native Node 24 executable that will
# be bundled as the low-footprint background sidecar.
AIHR_DESKTOP_NODE_BINARY=

# Optional output path for the five-minute desktop idle resource report.
AIHR_DESKTOP_RESOURCE_REPORT=
