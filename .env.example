# Optional local Ollama setup:
#   ollama pull embeddinggemma
#   AIHR_EMBEDDING_PROVIDER=ollama
#   AIHR_EMBEDDING_MODEL=embeddinggemma
#   AIHR_EMBEDDING_BASE_URL=http://127.0.0.1:11434
